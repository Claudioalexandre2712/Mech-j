# Copie para .env (local) ou cadastre em Vercel > Project > Settings > Environment Variables.
# Nunca faça commit do .env real.

# Destino das mensagens do formulário (obrigatório)
EMAIL_TO=mechjr.eng@gmail.com

# Opção A: SMTP (Gmail exige "senha de app": Conta Google > Segurança > Senhas de app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Opção B (opcional): Brevo. Se definida, é usada primeiro e o SMTP vira reserva.
BREVO_API_KEY=

# Remetente exibido (o e-mail precisa ser autorizado no provedor)
SENDER_NAME=Site Mech Jr
SENDER_EMAIL=
